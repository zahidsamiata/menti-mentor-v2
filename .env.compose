# docker-compose ortam değişkenleri şablonu
# Kullanım: cp .env.compose .env.compose.local ve gizli değerleri doldur

POSTGRES_USER=postgres
POSTGRES_PASSWORD=BURAYA_GUCLU_SIFRE_YAZIN
POSTGRES_DB=menti_mentor

# Min 32 karakter, production'da rastgele üret:
# openssl rand -base64 48
JWT_SECRET=BURAYA_MIN_32_KARAKTER_YAZIN
PLATFORM_ADMIN_KEY=BURAYA_PLATFORM_ADMIN_KEY_YAZIN
# Platform admin giriş e-postası. Boş bırakılırsa admin@platform.local kullanılır.
PLATFORM_ADMIN_EMAIL=

BACKEND_URL=https://api.sizinalaniniz.com
FRONTEND_URL=https://sizinalaniniz.com
BACKEND_PORT=3000
FRONTEND_PORT=3001

# ─── E-posta (Generic SMTP relay — öneri: Resend) ─────────────────────────────
# Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>
# Brevo : SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASS=<SMTP key>
# SMTP_FROM: SPF/DKIM doğrulanmış kurumsal domain (ör. noreply@sivilkapasite.org)
# SMTP_SECURE: 465 için boş bırak (otomatik true), 587 için "false".
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
